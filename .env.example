# Anthropic API key (or run `ant auth login` instead)
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# HYAKUME_MODEL=claude-opus-5          # model used for persona generation and the final digest
# HYAKUME_COLLECTOR_MODEL=claude-opus-5 # model used for per-persona web search (set to claude-sonnet-5 to cut cost)
# HYAKUME_EFFORT=high                   # low | medium | high | xhigh | max
# HYAKUME_DATA_DIR=./data
